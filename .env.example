# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (ask @userinfobot)
TELEGRAM_USER_ID=
# Reminder timezone
TZ=Europe/Zurich
# Optional: require ?token=... on the dashboard
DASHBOARD_TOKEN=

# Host path to the Obsidian vault (mounted read-only into the bot)
OBSIDIAN_VAULT=
# Comma-separated globs inside the vault to scan for inbox items
OBSIDIAN_INBOX_GLOBS=Inbox/**/*.md
# Optional: enables LLM inbox triage + (later) weekly summaries
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-sonnet-5
